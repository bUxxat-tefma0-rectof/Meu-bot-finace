# ===========================================
# LOJA DE GIFTCARDS - Variáveis de Ambiente
# ===========================================

# ===========================================
# BOT PRINCIPAL
# ===========================================
# Token do seu bot no Telegram (obrigatório)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyzWXYZ
BOT_USERNAME=GiftcardStore_bot

# ===========================================
# BANCO DE DADOS
# ===========================================
# Para desenvolvimento local (SQLite)
DATABASE_URL=sqlite+aiosqlite:///giftcards.db

# Para produção no Render (PostgreSQL) - descomente e configure:
# DATABASE_URL=postgresql+asyncpg://usuario:senha@host:5432/nome_do_banco

# ===========================================
# CANAL OBRIGATÓRIO
# ===========================================
# ID do canal (número negativo para canais/supergrupos)
REQUIRED_CHANNEL_ID=-1001234567890

# Link público do canal
REQUIRED_CHANNEL_LINK=https://t.me/seucanal

# Username do canal (com @)
REQUIRED_CHANNEL_USERNAME=@seucanal

# ===========================================
# PAGAMENTOS PIX
# ===========================================
# Provedor de pagamento (mercado_pago, efi, zendry, etc.)
PIX_PROVIDER=mercado_pago

# URL da API do provedor
PIX_API_URL=https://api.mercadopago.com/v1

# Credenciais da API (configure com seus dados reais)
PIX_API_KEY=TEST-1234567890-abcdefghij
PIX_CLIENT_ID=1234567890
PIX_CLIENT_SECRET=abcdefghijklmnopqrstuvwxyz1234567890

# URL do webhook para receber notificações
PIX_WEBHOOK_URL=https://seu-app.onrender.com/webhook/pix

# Ambiente: sandbox (testes) ou production (produção real)
PIX_ENVIRONMENT=sandbox

# Valores mínimo e máximo para recarga
PIX_MIN_VALUE=30.00
PIX_MAX_VALUE=1000.00

# Tempo de expiração do PIX em minutos
PIX_EXPIRATION_MINUTES=30

# Intervalo de verificação de pagamentos (em segundos)
PIX_POLL_INTERVAL=30

# ===========================================
# AFILIADOS
# ===========================================
# Porcentagem de comissão (ex: 10 = 10%)
AFFILIATE_COMMISSION_PERCENT=10.0

# Depósito mínimo para gerar comissão
AFFILIATE_MIN_DEPOSIT_FOR_COMMISSION=30.00

# ===========================================
# SUPORTE
# ===========================================
# Username ou link do suporte
SUPPORT_USERNAME=@suporte
SUPPORT_LINK=https://t.me/suporte

# ===========================================
# NOTIFICAÇÕES
# ===========================================
# Canal para receber notificações do sistema
NOTIFICATION_CHANNEL_ID=-1001234567890
NOTIFICATION_CHANNEL_LINK=@meucanal

# Ativar/desativar notificações
NOTIFICATIONS_ENABLED=true

# Notificações específicas
NOTIFY_ON_PURCHASE=true
NOTIFY_ON_NEW_STOCK=true
NOTIFY_ON_PIX_APPROVED=true
NOTIFY_ON_PIX_EXPIRED=false
NOTIFY_ON_NEW_USER=true
NOTIFY_ON_LOW_STOCK=true
NOTIFY_ON_COMMISSION=true

# Limite para alerta de estoque baixo
LOW_STOCK_THRESHOLD=5

# ===========================================
# SEGURANÇA
# ===========================================
# IDs dos administradores (separados por vírgula)
ADMIN_IDS=123456789,987654321

# Chave para criptografia (32 caracteres)
ENCRYPTION_KEY=minha_chave_super_secreta_aqui_32

# ===========================================
# ADMIN
# ===========================================
# Credenciais do painel administrativo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===========================================
# CONFIGURAÇÕES DE TEMPO
# ===========================================
# Janela para contador de visualizações (segundos)
VIEWER_WINDOW_SECONDS=300

# Tempo de vida de mensagens temporárias (segundos)
TEMP_MESSAGE_TTL=1800

# ===========================================
# DEPLOY NO RENDER
# ===========================================
# Porta para o servidor web (se usar webhook)
# PORT=8000

# URL pública do seu app no Render
# APP_URL=https://seu-app.onrender.com

# Não modificar
PYTHON_VERSION=3.11
